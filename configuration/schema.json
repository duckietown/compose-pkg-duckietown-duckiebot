            "default" : null
        },
        "duckiebot_hostname": {
            "details": "Hostname of the duckiebot",
            "type": "text",
            "default": null
        },
        "health_api" : {
            "details" : "Health API module configuration",
            "type" : "object",
            "_data" : {
                "hostname" : {
                    "type" : "text",
                    "default" : null,
                    "details" : "IP or Hostname of the machine running the Health API module"
                }
            },
            "__form__": {
                "title": "Health API"
            }
        },
        "files_api" : {
            "details" : "Files API module configuration",
            "type" : "object",
            "_data" : {
                "hostname" : {
                    "type" : "text",
                    "default" : null,
                    "details" : "IP or Hostname of the machine running the Files API module"
                }
            },
            "__form__": {
                "title": "Files API"
            }
        },
        "code_api" : {
            "details" : "Code API module configuration",
            "type" : "object",
            "_data" : {
                "hostname" : {
                    "type" : "text",
                    "default" : null,
                    "details" : "IP or Hostname of the machine running the Code API module"
                },
                "port" : {
                    "type" : "text",
                    "default" : 80,
                    "details" : "Port the Code API module is listening on"
