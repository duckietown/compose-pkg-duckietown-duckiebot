                "user",
                "superviror",
                "administrator"
            ],
            "authentication": [
                "web"
            ],
            "parameters": {
                "mandatory": {},
                "optional": {}
            }
        },
        "connect": {
            "details": "Connect the robot to a Wi-Fi network (may drop the current session)",
